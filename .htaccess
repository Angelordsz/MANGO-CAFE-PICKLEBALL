# Safety net: if the project root is exposed instead of public/, forward there.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block direct web access to application internals
<FilesMatch "\.(sql|log|md|docx)$">
    Require all denied
</FilesMatch>
